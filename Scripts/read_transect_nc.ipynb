    "THRESH_FILE = Path(r\"C:\\Users\\cvolp\\shorescan_processing\\DATA\\cumulative_power_thresholds_2024-10-01-2025-03-31.csv\")\n",
    "THRESH_TZ = \"UTC\"  # NDBC times are UTC; the downloader does not convert them\n",
    "THRESH_WINDOW_DAYS = 21  # LOOKBACK_DAYS / LOOKFWD_DAYS in the threshold notebook\n",
    "THRESH_MODE = \"cumulative\"  # \"band\": 0-200, 200-400, 400-600 (each burst once)\n",
    "#                      \"cumulative\": 0-200, 0-400, 0-600 (groups overlap)\n",
    "THRESH_COLORS = {200: \"skyblue\", 400: \"darkblue\", 600: \"red\"}\n",
    "OUTSIDE_COLOR = \"lightgray\"\n",
    "\n",
    "df_thresh = pd.read_csv(THRESH_FILE)\n",
    "\n",
    "\n",
    "def to_utc(values):\n",
    "    \"\"\"Parse times; naive ones are taken to be in THRESH_TZ.\"\"\"\n",
    "    t = pd.to_datetime(values)\n",
    "    return (t.dt.tz_localize(THRESH_TZ) if t.dt.tz is None else t).dt.tz_convert(\"UTC\")\n",
    "\n",
    "\n",
    "df_thresh[\"t_crossed_utc\"] = to_utc(df_thresh[\"datetime_crossed\"])\n",
    "df_thresh[\"t_survey_utc\"] = to_utc(df_thresh[\"survey_date\"])\n",
    "\n",
    "# Pair each survey's backward and forward crossing for the same threshold.\n",
    "# Pivoting on (survey, threshold) does this by key rather than by row order,\n",
    "# so a reordered or partly missing file can't mismatch them.\n",
