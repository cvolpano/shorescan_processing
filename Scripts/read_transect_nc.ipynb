    "df_ss = pd.read_csv(data_dir / f\"Shorescan_TWL_viewer_{RUN_TAG}.csv\")\n",
    "df_ss[\"dt0_utc\"] = pd.to_datetime(df_ss[\"dt0_utc\"], utc=True)\n",
    "\n",
    "# Compare every burst time with every interval at once: an n_bursts x\n",
    "# n_intervals True/False table (1,673 x a few intervals = a few kB), far\n",
    "# cheaper than a cross-join, which copies every CSV column per interval.\n",
    "# Times are compared as UTC numbers, not text, so -04:00/-05:00 offsets\n",
    "# can't break it.\n",
    "t = df_ss[\"dt0_utc\"].to_numpy()\n",
    "inside = ((t[:, None] >= intervals_df[\"start\"].to_numpy()[None, :])\n",
    "          & (t[:, None] <= intervals_df[\"end\"].to_numpy()[None, :]))\n",
    "thr_of_interval = intervals_df[\"thresh\"].to_numpy()\n",
    "thresholds = np.sort(np.unique(thr_of_interval))\n",
    "lower = dict(zip(thresholds, np.r_[0, thresholds[:-1]]))\n",
    "\n",
    "# Band: smallest threshold whose interval contains the burst (intervals are\n",
    "# sorted by threshold, so argmax finds it).\n",
    "first = inside.argmax(axis=1)\n",
    "df_ss[\"thresh\"] = np.where(inside.any(axis=1), thr_of_interval[first], np.nan)\n",
    "\n",
    "# Group membership, one column per threshold:\n",
    "#   band       -> the burst's own band only\n",
    "#   cumulative -> any interval with threshold <= T\n",
    "if THRESH_MODE == \"band\":\n",
    "    member = df_ss[\"thresh\"].to_numpy()[:, None] == thresholds[None, :]\n",
    "    names = [f\"{lower[T]:.0f}–{T:.0f} kWh/m\" for T in thresholds]\n",
    "elif THRESH_MODE == \"cumulative\":\n",
    "    member = np.column_stack([inside[:, thr_of_interval <= T].any(axis=1)\n",
    "                              for T in thresholds])  # one column per threshold\n",
    "    names = [f\"0–{T:.0f} kWh/m\" for T in thresholds]\n",
    "else:\n",
    "    raise ValueError('THRESH_MODE must be \"band\" or \"cumulative\"')\n",
    "\n",
    "# Long table: one row per (burst, group). np.nonzero lists every True cell,\n",
    "# so a burst in three cumulative groups becomes three rows.\n",
    "rows, cols = np.nonzero(member)\n",
    "OUTSIDE = \"outside intervals\"\n",
    "outside = np.flatnonzero(~inside.any(axis=1))\n",
    "df_groups = pd.concat([\n",
    "    df_ss.iloc[rows].assign(thresh_label=np.array(names)[cols],\n",
