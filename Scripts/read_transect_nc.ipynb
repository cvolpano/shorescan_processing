    "RECOMPUTE_TWL = True   # TWL from Ri on the cleaned profile (falls back per file)\n",
    "SPIKE_M = 0.3          # m from the running median to count as a spike\n",
    "SPIKE_WIN = 9          # points in the running median (odd)\n",
    "RI_MATCH_TOL = 0.01    # m; Ri lookup on the raw profile must reproduce TWL\n",
    "\n",
    "\n",
    "def clean_profile(elev):\n",
    "    \"\"\"Remove no-data zeros and single-point spikes from elevation_transect.\n",
    "\n",
    "    Returns (cleaned profile, no_data mask, spike mask). Zeros become NaN;\n",
    "    spikes are replaced by linear interpolation between good neighbours,\n",
    "    only inside the surveyed span.\n",
    "    \"\"\"\n",
    "    z = np.asarray(elev, dtype=float).copy()\n",
    "    no_data = z == 0.0\n",
    "    z[no_data] = np.nan\n",
    "    med = (pd.Series(z).rolling(SPIKE_WIN, center=True, min_periods=3)\n",
    "           .median().to_numpy())\n",
    "    spike = np.abs(z - med) > SPIKE_M          # NaN compares False\n",
    "    z[spike] = np.nan\n",
    "    idx = np.arange(z.size)\n",
    "    good = np.isfinite(z)\n",
    "    if good.sum() >= 2:\n",
    "        inside = (idx >= idx[good][0]) & (idx <= idx[good][-1])\n",
    "        fill = np.interp(idx, idx[good], z[good])\n",
    "        z = np.where(spike & inside, fill, z)\n",
    "    return z, no_data, spike\n",
    "\n",
    "\n",
    "def runup_elevation(twl, ri, elev, profile):\n",
    "    \"\"\"Runup elevation series on the cleaned profile, if Ri can be trusted.\n",
    "\n",
    "    Returns (z, off_profile, source, match_m):\n",
    "      z           elevation of the runup line, m NAVD88 (NaN = unknown)\n",
    "      off_profile samples whose runup pixel has no surveyed elevation\n",
    "      source      \"Ri\" (recomputed) or \"file\" (Shorescan TWL, zeros masked)\n",
    "      match_m     median |TWL - raw-profile lookup| used for the check\n",
    "    \"\"\"\n",
    "    idx = np.arange(np.asarray(elev).size)\n",
    "    ok_ri = np.isfinite(ri)\n",
    "    match = np.nan\n",
    "    if RECOMPUTE_TWL and ok_ri.any() and idx.size == np.asarray(profile).size:\n",
    "        raw = np.interp(ri, idx, elev)          # what Shorescan should have\n",
    "        match = np.nanmedian(np.abs(raw - twl))\n",
    "        if match <= RI_MATCH_TOL:\n",
    "            z = np.full(twl.shape, np.nan)\n",
    "            z[ok_ri] = np.interp(ri[ok_ri], idx, profile)  # NaN on no-data\n",
    "            off = ok_ri & np.isnan(z)\n",
    "            return z, off, \"Ri\", match\n",
    "    off = twl == 0.0\n",
    "    z = np.where(off, np.nan, twl) if ZERO_IS_FILL else twl\n",
    "    return z, off, \"file\", match"
   ]
  },
