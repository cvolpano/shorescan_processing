   "source": [
    "# --- Block A: readers and per-burst statistics -----------------------------\n",
    "# Forecast terms stored in each file (scalars): CSV column -> netCDF name.\n",
    "FC_VARS = {\"cc_twl\": \"twl\", \"cc_twl05\": \"twl05\", \"cc_twl95\": \"twl95\",\n",
    "           \"cc_tide\": \"twl_tide\", \"cc_setup\": \"twl_setup\",\n",
    "           \"cc_ru_2pct\": \"twl_runup\", \"cc_ru05\": \"twl_runup05\",\n",
    "           \"cc_ru95\": \"twl_runup95\", \"cc_swash\": \"twl_swash\",\n",
    "           \"cc_swash_inc\": \"twl_incSwash\", \"cc_swash_ig\": \"twl_igSwash\",\n",
    "           \"cc_Hs\": \"twl_hs\", \"cc_Tp\": \"twl_pp\"}\n",
    "# Shorescan's own burst statistics. The exceedance and setup values are\n",
    "# heights above the tide Shorescan subtracted (Zrunup = TWL - twl_tide).\n",
    "SS_FILE_VARS = {\"rel_2pct_peaks\": \"TWLstats_2exceedence_peaks\",\n",
    "                \"rel_2pct_series\": \"TWLstats_2exceedence_notpeaks\",\n",
    "                \"ss_setup_file\": \"TWLstats_setup\",\n",
    "                \"ss_S_file\": \"TWLstats_Ssig\", \"ss_S_ss\": \"TWLstats_Ssig_SS\",\n",
    "                \"ss_S_ig\": \"TWLstats_Ssig_IG\", \"ss_Tpeak\": \"TWLstats_Tpeak\",\n",
    "                \"ss_Tmean\": \"TWLstats_Tmean\", \"beta06\": \"TWLstats_betaS2006\",\n",
    "                \"ss_beta\": \"TWLstats_beta\"}\n",
    "\n",
    "\n",
    "def read_var(ds, name):\n",
    "    \"\"\"Variable `name` as float64, fill/masked values -> NaN (NaN if absent).\"\"\"\n",
    "    if name not in ds.variables:\n",
    "        return np.array(np.nan)\n",
    "    return np.ma.filled(np.ma.asarray(ds[name][...], dtype=float), np.nan)\n",
    "\n",
    "\n",
    "def read_scalar(ds, name):\n",
    "    \"\"\"One float from a scalar variable (NaN if absent or all fill).\"\"\"\n",
    "    values = read_var(ds, name)\n",
    "    return float(np.nanmean(values)) if np.isfinite(values).any() else np.nan\n",
    "\n",
    "\n",
    "def read_times_s(ds):\n",
    "    \"\"\"Sample times T as Unix seconds, or None if T is missing/unreadable.\"\"\"\n",
    "    if \"T\" not in ds.variables:\n",
    "        return None\n",
    "    var = ds[\"T\"]\n",
    "    try:\n",
    "        vals = var[...]\n",
    "        if \"since\" in getattr(var, \"units\", \"\"):      # numeric with units\n",
    "            vals = nc.num2date(vals, var.units,\n",
    "                               only_use_cftime_datetimes=False)\n",
    "        elif getattr(vals, \"dtype\", None) is not None and vals.dtype.kind == \"S\":\n",
    "            vals = nc.chartostring(vals)               # char array -> str\n",
    "        t = pd.to_datetime(np.asarray(vals).ravel().astype(str), utc=True)\n",
    "        return ((t - pd.Timestamp(\"1970-01-01\", tz=\"UTC\"))\n",
    "                / pd.Timedelta(\"1s\")).to_numpy()\n",
    "    except (ValueError, TypeError, AttributeError, OverflowError):\n",
    "        return None\n",
    "\n",
    "\n",
    "def runup_maxima(z):\n",
    "    \"\"\"Highest point of each swash event in a runup elevation series.\n",
    "\n",
    "    An event runs from one up-crossing of the series mean to the next, the\n",
    "    usual way to pick individual runup maxima (Stockdon et al., 2006).\n",
    "    NaN samples are removed first, so a gap joins its neighbours.\n",
    "    \"\"\"\n",
    "    z = z[np.isfinite(z)]\n",
    "    if z.size < 3:\n",
    "        return np.array([])\n",
    "    above = z > z.mean()\n",
    "    up = np.flatnonzero(~above[:-1] & above[1:]) + 1  # up-crossing indices\n",
    "    if up.size < 2:\n",
    "        return np.array([])\n",
    "    # reduceat takes the max of each slice z[up[i]:up[i+1]] in one call.\n",
    "    return np.maximum.reduceat(z[up[0]:up[-1]], up[:-1] - up[0])\n",
    "\n",
    "\n",
    "def burst_stats(z, off_profile, ref_tide, profile, fc, fs):\n",
    "    \"\"\"Statistics for one burst. All elevations m NAVD88, heights m.\n",
    "\n",
    "    z           : runup-line elevation series (from runup_elevation)\n",
    "    off_profile : samples with no surveyed elevation (seaward of the survey)\n",
    "    ref_tide    : tide Shorescan subtracted, median(TWL - Zrunup)\n",
    "    profile     : cleaned elevation_transect\n",
    "    fc          : forecast scalars, already datum-corrected\n",
    "    fs          : Shorescan's own scalar statistics (SS_FILE_VARS)\n",
    "    \"\"\"\n",
    "    finite = np.isfinite(z)\n",
    "    # Samples where the runup line sits at either end of the surveyed profile.\n",
    "    if np.isfinite(profile).any():\n",
    "        e_lo, e_hi = np.nanmin(profile), np.nanmax(profile)\n",
    "        at_limit = finite & ((np.abs(z - e_lo) <= LIMIT_TOL_M)\n",
    "                             | (np.abs(z - e_hi) <= LIMIT_TOL_M))\n",
    "    else:\n",
    "        e_lo = e_hi = np.nan\n",
    "        at_limit = np.zeros_like(finite)\n",
    "\n",
    "    peaks = runup_maxima(z)\n",
    "    # Share of samples at the burst's most common elevation: high when the\n",
    "    # runup line is pinned (flat berm, transect end, misdetection).\n",
    "    _, counts = np.unique(np.round(z[finite], 3), return_counts=True)\n",
    "    mode_frac = counts.max() / counts.sum() if counts.size else np.nan\n",
    "    swl = fc[\"cc_tide\"] - fc[\"cc_setup\"]  # forecast tide + surge, no setup\n",
    "    n_total = z.size\n",
    "\n",
    "    out = {\n",
    "        # Elevations of the runup line, m NAVD88\n",
    "        \"ss_twl_mean\": np.nanmean(z), \"ss_twl_min\": np.nanmin(z),\n",
    "        \"ss_twl_max\": np.nanmax(z), \"ss_twl_std\": np.nanstd(z),\n",
    "        \"ss_twl_2pct\": np.nanpercentile(z, 98),\n",
    "        \"ss_twl_2pct_peaks\": (np.percentile(peaks, 98)\n",
    "                              if peaks.size >= MIN_PEAKS else np.nan),\n",
    "        \"ss_n_peaks\": peaks.size,\n",
    "        # Shorescan's own exceedance values, converted back to elevations\n",
    "        \"ss_twl_2pct_peaks_file\": fs[\"rel_2pct_peaks\"] + ref_tide,\n",
    "        \"ss_twl_2pct_file\": fs[\"rel_2pct_series\"] + ref_tide,\n",
    "        # Swash: 4 x std of the cleaned series, plus Shorescan's spectral values\n",
    "        \"ss_S\": 4 * np.nanstd(z),\n",
    "        **{k: fs[k] for k in (\"ss_S_file\", \"ss_S_ss\", \"ss_S_ig\", \"ss_Tpeak\",\n",
    "                              \"ss_Tmean\", \"ss_setup_file\", \"beta06\",\n",
    "                              \"ss_beta\")},\n",
    "        # Forecast (datum-corrected) and the matching still water level\n",
    "        **fc, \"cc_swl\": swl, \"ss_ref_tide\": ref_tide,\n",
    "        # QC\n",
    "        \"n_samples\": n_total, \"n_valid\": int(finite.sum()),\n",
    "        \"n_zero\": int(off_profile.sum()),   # seaward of the survey / 0.000 m\n",
    "        \"n_at_limit\": int(at_limit.sum()),\n",
    "        \"mode_frac\": mode_frac,\n",
    "        \"elev_min\": e_lo, \"elev_max\": e_hi,\n",
    "    }\n",
    "    # Heights above forecast tide + surge, as TWL&CC defines R2% and setup\n",
    "    out[\"ss_R2\"] = out[\"ss_twl_2pct_peaks\"] - swl\n",
    "    out[\"ss_setup\"] = out[\"ss_twl_mean\"] - swl\n",
    "    out[\"frac_bad\"] = (out[\"n_zero\"] + out[\"n_at_limit\"]) / max(n_total, 1)\n",
    "    return out\n",
    "\n",
    "\n",
    "# --- Block B: one row of statistics per file ------------------------------\n",
    "rows, skipped = [], []\n",
    "for file in sorted(batch_nc_dir.glob(\"*.nc\")):\n",
    "    m = STACK_RE.match(file.name)\n",
    "    if m is None:\n",
    "        skipped.append((file.name, \"filename did not match pattern\"))\n",
    "        continue\n",
    "    try:\n",
    "        with nc.Dataset(file) as ds:\n",
    "            twl = read_var(ds, \"TWL\")\n",
    "            zr = read_var(ds, \"Zrunup\")\n",
    "            ri = read_var(ds, \"Ri\")\n",
    "            elev = read_var(ds, \"elevation_transect\")\n",
    "            fc = {k: read_scalar(ds, v) for k, v in FC_VARS.items()}\n",
    "            fs = {k: read_scalar(ds, v) for k, v in SS_FILE_VARS.items()}\n",
    "            t_s = read_times_s(ds)\n",
    "    except (OSError, IndexError, ValueError, KeyError) as e:\n",
    "        skipped.append((file.name, str(e)))\n",
    "        continue\n",
    "\n",
    "    for k in DATUM_FIX_COLS:\n",
    "        fc[k] += DATUM_FIX_M\n",
    "\n",
    "    # nan* stats of an all-NaN burst warn and return NaN; QC drops it below\n",
    "    with warnings.catch_warnings():\n",
    "        warnings.simplefilter(\"ignore\", RuntimeWarning)\n",
    "        profile, no_data, spike = clean_profile(elev)\n",
    "        z, off_profile, source, match = runup_elevation(twl, ri, elev, profile)\n",
    "        # The tide Shorescan subtracted: TWL - Zrunup (constant in a burst).\n",
    "        ref_tide = (np.nanmedian(twl - zr) if np.isfinite(twl - zr).any()\n",
    "                    else np.nan)\n",
    "        row = burst_stats(z, off_profile, ref_tide, profile, fc, fs)\n",
    "    row.update(twl_source=source, ri_match_m=match,\n",
    "               n_profile_spikes=int(spike.sum()),\n",
    "               n_profile_nodata=int(no_data.sum()))\n",
    "    ts = int(m[\"timestamp\"])\n",
    "    row.update(\n",
    "        transect=int(m[\"transect\"]), camera=m[\"camera\"],\n",
    "        station=m[\"station\"], filename=file.name, timestamp=ts,\n",
    "        # Capture mid-time and length from T; NaN -> filled in Block C\n",
    "        mid_offset_s=(np.nanmean([t_s.min(), t_s.max()]) - ts\n",
    "                      if t_s is not None and t_s.size else np.nan),\n",
    "        duration_s=(t_s.max() - t_s.min()\n",
    "                    if t_s is not None and t_s.size else np.nan))\n",
    "    rows.append(row)\n",
    "\n",
    "df_all = pd.DataFrame(rows)\n",
    "if df_all.empty:\n",
    "    n_found = len(list(batch_nc_dir.glob(\"*.nc\")))\n",
    "    reasons = \"\\n\".join(f\"  {n}: {r}\" for n, r in skipped[:10])\n",
    "    raise RuntimeError(\n",
    "        f\"No usable files in {batch_nc_dir} ({n_found} .nc files found).\"\n",
    "        f\"\\nFirst skip reasons:\\n{reasons or '  (none: folder has no .nc files)'}\"\n",
    "    )\n",
    "\n",
    "# --- Block C: vectorised time conversion + QC ------------------------------\n",
    "no_t = df_all[\"mid_offset_s\"].isna()\n",
    "df_all.loc[no_t, \"mid_offset_s\"] = df_all[\"n_samples\"] / SAMPLE_HZ / 2\n",
    "df_all[\"dt0_utc\"] = pd.to_datetime(df_all[\"timestamp\"], unit=\"s\", utc=True)\n",
    "df_all[\"dt0\"] = df_all[\"dt0_utc\"].dt.tz_convert(LOCAL_TZ)\n",
    "df_all[\"t_mid_utc\"] = df_all[\"dt0_utc\"] + pd.to_timedelta(\n",
    "    df_all[\"mid_offset_s\"], unit=\"s\")\n",
    "df_all[\"clipped\"] = df_all[\"frac_bad\"] > CLIP_FRAC\n",
    "df_all[\"implausible\"] = (df_all[\"ss_setup\"].notna()\n",
    "                         & ~df_all[\"ss_setup\"].between(*SETUP_RANGE))\n",
    "pairs = pd.MultiIndex.from_frame(df_all[[\"camera\", \"transect\"]])\n",
    "df_all[\"excluded\"] = None if EXCLUDE is None else pairs.isin(EXCLUDE)\n",
    "df_all[\"use\"] = True #(df_all[\"clipped\"] | df_all[\"implausible\"]| df_all[\"excluded\"] | )\n",
    "print(len(df_all), \"files read, QC flags set\")\n",
    "required = [\"cc_twl\", \"cc_tide\", \"cc_setup\", \"cc_ru_2pct\", \"cc_Hs\",\n",
    "            \"ss_twl_mean\", \"ss_twl_max\", \"ss_twl_std\", \"ss_twl_2pct\"]\n",
    "finite = (df_all[required].to_numpy()).all(axis=1) #np.isfinite(df_all[required].to_numpy()).all(axis=1)\n",
    "skipped += [(f, \"non-finite values\") for f in df_all.loc[~finite, \"filename\"]]\n",
    "front = [\"transect\", \"camera\", \"station\", \"dt0\", \"dt0_utc\", \"t_mid_utc\",\n",
    "         \"use\", \"clipped\", \"implausible\", \"excluded\"]\n",
    "df_all = (df_all.loc[finite, front + [c for c in df_all if c not in front]]\n",
    "          .drop(columns=\"mid_offset_s\")\n",
    "          .sort_values([\"transect\", \"camera\", \"dt0_utc\"])\n",
    "          .reset_index(drop=True))\n",
    "\n",
    "print(f\"Kept {len(df_all)} files, skipped {len(skipped)}\")\n",
    "for name, reason in skipped[:20]:\n",
    "    print(f\"  skipped {name}: {reason}\")\n",
    "print(f\"Datum fix +{DATUM_FIX_M} m applied to {', '.join(DATUM_FIX_COLS)}\")\n",
    "print(f\"Mid-time from T for {(~no_t).sum()} files, from SAMPLE_HZ for {no_t.sum()}\")\n",
    "src = df_all[\"twl_source\"].value_counts()\n",
    "print(f\"Runup elevation recomputed from Ri on the cleaned profile: {src.get('Ri', 0)} \"\n",
    "      f\"files; Shorescan TWL kept: {src.get('file', 0)} \"\n",
    "      f\"(median Ri-lookup mismatch {df_all['ri_match_m'].median():.4f} m)\")\n",
    "print(f\"Profile spikes removed per file: median {df_all['n_profile_spikes'].median():.0f}, \"\n",
    "      f\"max {df_all['n_profile_spikes'].max()}\")\n",
    "print(f\"Bursts with zero samples: {(df_all['n_zero'] > 0).sum()}; \"\n",
    "      f\"flagged clipped (> {CLIP_FRAC:.0%} zero or at a transect end): \"\n",
    "      f\"{df_all['clipped'].sum()}; implausible setup outside {SETUP_RANGE} m: \"\n",
    "      f\"{df_all['implausible'].sum()}; excluded pairs {EXCLUDE}: \"\n",
    "     f\"{df_all['excluded'].sum()}; used: {df_all['use'].sum()}\")\n",
    "# Shorescan's peak statistic vs this notebook's, both as elevations\n",
    "d = df_all[\"ss_twl_2pct_peaks\"] - df_all[\"ss_twl_2pct_peaks_file\"]\n",
    "print(f\"2% peaks, this notebook minus Shorescan file: median {d.median():+.3f} m \"\n",
    "      f\"(non-clipped: {d[~df_all['clipped']].median():+.3f} m)\")\n",
    "# Shorescan's reference tide should equal the raw (uncorrected) forecast tide\n",
    "d = df_all[\"ss_ref_tide\"] - (df_all[\"cc_tide\"] - DATUM_FIX_M)\n",
    "print(f\"Reference tide minus raw twl_tide: max |diff| {d.abs().max():.4f} m\")\n",
    "\n",
    "# --- Block D: write CSVs ---------------------------------------------------\n",
    "for (transect, camera), grp in df_all.groupby([\"transect\", \"camera\"]):\n",
    "    out = data_dir / (f\"Shorescan_TWL_viewer_Transect{transect}_{camera}\"\n",
    "                      f\"_sensor_{RUN_TAG}.csv\")\n",
    "    grp.to_csv(out, index=False)\n",
    "    print(f\"Wrote {len(grp):4d} rows to {out.name}\")\n",
    "\n",
    "for transect, grp in df_all.groupby(\"transect\"):\n",
    "    out = data_dir / (f\"Shorescan_TWL_viewer_Transect{transect}_ALLCAMERAS\"\n",
    "                      f\"_sensor_{RUN_TAG}.csv\")\n",
    "    grp.to_csv(out, index=False)\n",
    "    print(f\"Wrote {len(grp):4d} rows to {out.name}\")\n",
    "\n",
    "out = data_dir / f\"Shorescan_TWL_viewer_{RUN_TAG}.csv\"\n",
    "df_all.to_csv(out, index=False)\n",
    "print(f\"Wrote {len(df_all):4d} rows to {out.name}\")"
   ]
  },
