    "def fit_stats(fc, obs):\n",
    "    \"\"\"n, r, R2, bias, RMSE and the obs-on-fc fit for paired values.\"\"\"\n",
    "    ok = np.isfinite(fc) & np.isfinite(obs)\n",
    "    fc, obs = np.asarray(fc)[ok], np.asarray(obs)[ok]\n",
    "    if fc.size < 3:\n",
    "        return pd.Series({\"n\": fc.size})\n",
    "    err = fc - obs\n",
    "    r = np.corrcoef(fc, obs)[0, 1]\n",
    "    slope, intercept = np.polyfit(fc, obs, 1)\n",
    "    return pd.Series({\"n\": fc.size, \"r\": r, \"R2\": r**2, \"bias\": err.mean(),\n",
    "                      \"rmse\": np.sqrt((err**2).mean()), \"slope\": slope,\n",
    "                      \"intercept\": intercept})\n",
    "\n",
    "\n",
    "def stats_box(ax, df, x, y, group, order=None, all_df=None):\n",
    "    \"\"\"Write per-group and overall fit statistics in the top-left corner.\n",
    "\n",
    "    all_df: rows for the \"all\" line when df repeats bursts across groups\n",
    "    (cumulative mode); default df.\n",
    "    \"\"\"\n",
    "    by_group = df.groupby(group).apply(\n",
    "        lambda d: fit_stats(d[x], d[y]), include_groups=False)\n",
    "    base = df if all_df is None else all_df\n",
    "    table = pd.concat([by_group.reindex(order) if order else by_group,\n",
    "                       fit_stats(base[x], base[y]).to_frame(\"all\").T])\n",
    "    w = max(len(str(name)) for name in table.index)  # align the columns\n",
    "    lines = [f\"{str(name):<{w}}  n={s.n:4.0f}\" + (\n",
    "             f\"  r={s.r:.2f}  R²={s.R2:.2f}  bias={s.bias:+.2f} m  \"\n",
    "             f\"RMSE={s.rmse:.2f} m  fit={s.slope:.2f}x{s.intercept:+.2f}\"\n",
    "             if s.n >= 3 else \"\") for name, s in table.iterrows()]\n",
    "    ax.text(0.02, 0.98, \"\\n\".join(lines), transform=ax.transAxes, va=\"top\",\n",
    "            fontsize=8, family=\"monospace\",\n",
    "            bbox={\"fc\": \"white\", \"alpha\": 0.85, \"lw\": 0.5})\n",
    "    return table\n",
    "\n",
    "\n",
    "scatter_kws = {\"linewidths\": 0.3, \"s\": 15, \"alpha\": 0.8, \"edgecolor\": \"k\"}\n",
    "\n",
    "for transect in TRANSECTS:\n",
    "    csv = data_dir / (f\"Shorescan_TWL_viewer_Transect{transect}_ALLCAMERAS\"\n",
    "                      f\"_sensor_{RUN_TAG}.csv\")\n",
    "    if not csv.exists():\n",
    "        print(f\"Skipping transect {transect}: {csv.name} not found\")\n",
    "        continue\n",
    "    df_ss = pd.read_csv(csv)\n",
    "    df_ss = df_ss[df_ss[\"use\"]]  # see Section 2b\n",
    "    dt_local = pd.to_datetime(df_ss[\"dt0\"], utc=True).dt.tz_convert(LOCAL_TZ)\n",
    "    d0, d1 = dt_local.min().date(), dt_local.max().date()\n",
    "\n",
    "    g = sns.lmplot(data=df_ss, x=\"cc_twl\", y=\"ss_twl_2pct_peaks\", hue=\"camera\",\n",
    "                   height=8, legend=False, scatter_kws=scatter_kws)\n",
    "    ax = g.ax\n",
    "    lims = [min(ax.get_xlim()[0], ax.get_ylim()[0]),\n",
    "            max(ax.get_xlim()[1], ax.get_ylim()[1])]\n",
    "    ax.plot(lims, lims, color=\"black\", linestyle=\"-\", label=\"1:1 line\")\n",
    "    ax.set(xlim=lims, ylim=lims, aspect=\"equal\",\n",
    "           xlabel=\"TWL Viewer total water level (m NAVD88)\",\n",
    "           ylabel=\"Shorescan 2% runup elevation (m NAVD88)\",\n",
    "           title=f\"TWL Viewer vs Shorescan, {d0} to {d1}\\nTransect {transect}\")\n",
    "    ax.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "    ax.legend(loc=\"lower right\")\n",
    "    table = stats_box(ax, df_ss, \"cc_twl\", \"ss_twl_2pct_peaks\", \"camera\")\n",
    "    print(f\"Transect {transect}\\n{table.round(3)}\\n\")\n",
    "    g.figure.tight_layout()\n",
    "    out_png = plot_dir / f\"TWLvSS_{d0}-{d1}_Transect{transect}.png\"\n",
    "    g.savefig(out_png, dpi=150)\n",
    "    plt.show()"
   ]
