    "for f in sorted(burst_nc_dir.glob(\"*.nc\")):\n",
    "    m = STACK_RE.match(f.name)\n",
    "    if m:\n",
    "        bursts[f.name[:m.end(\"camera\")]][int(m[\"transect\"])] = f\n",
    "if not bursts:\n",
    "    raise FileNotFoundError(f\"No Shorescan .nc files matching STACK_RE in {burst_nc_dir}\")\n",
    "if burst_id is None:\n",
    "    burst_id = next(iter(bursts))\n",
    "if burst_id not in bursts:\n",
    "    raise ValueError(f\"{burst_id} not in {burst_nc_dir}. {len(bursts)} bursts found, \"\n",
    "                     f\"e.g.:\\n  \" + \"\\n  \".join(list(bursts)[:5]))\n",
    "\n",
    "files = bursts[burst_id]\n",
    "meta = STACK_RE.match(next(iter(files.values())).name).groupdict()\n",
    "dt_burst = pd.Timestamp(int(meta[\"timestamp\"]), unit=\"s\", tz=\"UTC\")\n",
    "print(f\"{burst_id}: transects {sorted(files)}\")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(12, 4))\n",
    "colors = plt.colormaps[\"Spectral\"](np.linspace(0, 1, len(TRANSECTS)))\n",
    "\n",
    "for transect, color in zip(TRANSECTS, colors):\n",
    "    file_path = files.get(transect)\n",
    "    if file_path is None:\n",
    "        print(f\"No transect {transect} for this burst\")\n",
    "        continue\n",
    "    try:\n",
    "        with xr.open_dataset(file_path) as ds:\n",
    "            x = ds[\"localX_transect\"].values      # local cross-shore (m)\n",
    "            elev = ds[\"elevation_transect\"].values\n",
    "    except (OSError, KeyError, ValueError) as e:\n",
    "        print(f\"Failed to read {file_path.name}: {e}\")\n",
    "        continue\n",
    "    prof, no_data, spike = clean_profile(elev)\n",
    "    ax.plot(x, elev, color=color, lw=0.8, ls=\":\", alpha=0.6)   # raw\n",
    "    ax.plot(x, prof, color=color, label=f\"Transect {transect}\")  # cleaned\n",
    "    ax.plot(x[spike], elev[spike], \"x\", color=color, ms=6)\n",
    "    print(f\"  transect {transect}: {no_data.sum()} no-data zeros, \"\n",
    "          f\"{spike.sum()} spikes removed\")\n",
    "\n",
    "if ax.has_data():\n",
    "    ax.set(xlim=(0, 150), ylim=(-1, 7),\n",
    "           xlabel=\"Local cross-shore distance (m)\",\n",
    "           ylabel=\"Projected elevation (m NAVD88)\",\n",
    "           title=(f\"Shorescan transect elevations ({meta['station']} {meta['camera']})\\n\"\n",
    "                  f\"{dt_burst:%b %d, %Y %H:%M} UTC\"))\n",
    "    ax.grid(True)\n",
    "    ax.plot([], [], \"k:\", lw=0.8, label=\"raw profile\")\n",
    "    ax.plot([], [], \"kx\", label=\"spike removed\")\n",
    "    ax.legend(loc=\"upper right\")\n",
    "    out_png = plot_dir / (f\"Transect_elevations_{meta['station']}_{meta['camera']}_\"\n",
    "                          f\"{dt_burst:%Y%m%d_%H%M}UTC.png\")\n",
    "    fig.savefig(out_png, dpi=150, bbox_inches=\"tight\")\n",
    "    print(f\"Plot saved to {out_png}\")\n",
    "    plt.show()\n",
    "else:\n",
    "    plt.close(fig)\n",
    "    print(\"No data found, figure not saved\")"
