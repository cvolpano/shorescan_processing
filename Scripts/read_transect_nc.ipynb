    "PLATEAU_WIN = 0.15    # m, about one elevation step either side\n",
    "PLATEAU_SHARE = 0.25  # this share of used bursts in one window = plateau\n",
    "\n",
    "\n",
    "def densest_window(z, width):\n",
    "    \"\"\"Lower edge of the width-wide window holding most values, and its share.\n",
    "\n",
    "    Sorting once, then one searchsorted call, gives the count in the window\n",
    "    starting at every value; argmax picks the fullest.\n",
    "    \"\"\"\n",
    "    s = np.sort(z[np.isfinite(z)])\n",
    "    if s.size == 0:\n",
    "        return np.nan, np.nan\n",
    "    n_in = np.searchsorted(s, s + width, side=\"right\") - np.arange(s.size)\n",
    "    k = n_in.argmax()\n",
    "    return s[k], n_in[k] / s.size\n",
    "\n",
    "\n",
    "def qc_row(g):\n",
    "    \"\"\"QC summary for one camera/transect group.\"\"\"\n",
    "    u = g[g[\"use\"]]\n",
    "    z0, share = densest_window(u[\"ss_twl_2pct_peaks\"].to_numpy(), PLATEAU_WIN)\n",
    "    levels = np.sort(g[\"ss_twl_max\"].round(4).unique())\n",
    "    return pd.Series({\n",
    "        \"n\": len(g), \"clipped\": g[\"clipped\"].mean(),\n",
    "        \"implausible\": g[\"implausible\"].mean(), \"excluded\": g[\"excluded\"].any(),\n",
    "        \"median_setup_m\": g[\"ss_setup\"].median(),\n",
    "        \"step_m\": np.median(np.diff(levels)) if levels.size > 2 else np.nan,\n",
    "        \"plateau_from_m\": z0, \"plateau_share\": share,\n",
    "        \"r_used\": u[\"cc_twl\"].corr(u[\"ss_twl_2pct_peaks\"])})\n",
    "\n",
    "\n",
    "qc = df_all.groupby([\"camera\", \"transect\"]).apply(qc_row, include_groups=False)\n",
    "print(qc.round(3).to_string())\n",
    "\n",
    "groups = list(df_all.groupby([\"camera\", \"transect\"]))\n",
    "ncol = 3\n",
    "nrow = -(-len(groups) // ncol)\n",
    "fig, axes = plt.subplots(nrow, ncol, figsize=(4.2 * ncol, 4 * nrow),\n",
    "                         squeeze=False, layout=\"constrained\")\n",
    "for ax in axes.flat[len(groups):]:\n",
    "    ax.set_visible(False)\n",
    "for ax, ((cam, tr), g) in zip(axes.flat, groups):\n",
    "    x, y = g[\"cc_twl\"], g[\"ss_twl_2pct_peaks\"]\n",
    "    \n",
    "    ax.plot(x[g[\"use\"]], y[g[\"use\"]], \".\", color=\"k\", ms=3, label=\"used\")\n",
    "    ax.plot(x[g[\"clipped\"]], y[g[\"clipped\"]], \"o\", mfc=\"none\", color=\"0.6\",\n",
    "            ms=4, label=\"clipped\")\n",
    "    ax.plot(x[g[\"implausible\"]], y[g[\"implausible\"]], \"x\", color=\"tab:orange\",\n",
    "             ms=4, label=\"implausible\")\n",
    "    lims = [np.nanmin([x.min(), y.min()]), np.nanmax([x.max(), y.max()])]\n",
    "    ax.plot(lims, lims, \"k-\", lw=0.8)\n",
    "    q = qc.loc[(cam, tr)]\n",
    "    if q[\"plateau_share\"] >= PLATEAU_SHARE:\n",
    "        ax.axhspan(q[\"plateau_from_m\"], q[\"plateau_from_m\"] + PLATEAU_WIN,\n",
    "                   color=\"tab:red\", alpha=0.15, lw=0)\n",
    "    ax.set_title(f\"{cam} t{tr}\" + (\" (excluded)\" if q[\"excluded\"] else \"\")\n",
    "                 + f\"\\nsetup {q['median_setup_m']:.2f} m, r = {q['r_used']:.2f}\",\n",
    "                 fontsize=9)\n",
    "    ax.set(xlabel=\"TWL Viewer TWL (m NAVD88)\",\n",
    "           ylabel=\"Shorescan 2% runup elev. (m NAVD88)\")\n",
    "    ax.grid(True, ls=\"--\", alpha=0.4)\n",
    "axes.flat[0].legend(fontsize=8, loc=\"upper left\")\n",
    "fig.savefig(plot_dir / f\"QC_obs_vs_forecast_{RUN_TAG}.png\", dpi=150)\n",
    "plt.show()"
